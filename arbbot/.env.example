# ============================================================
#  ArbBot settings. Copy to .env (same folder you run from)
#  and fill in. NEVER share or commit your .env file.
# ============================================================

# ---- Safety -------------------------------------------------
# true  = paper trading only; live switching is locked.
# false = live trading can be enabled from the dashboard,
#         after a double confirmation (checkbox + typing LIVE).
PAPER_MODE=true

# ---- What to watch ------------------------------------------
# At least two of: binance, okx, bybit, kucoin
EXCHANGES=binance,okx,kucoin
SYMBOLS=BTC/USDT,ETH/USDT,SOL/USDT,XRP/USDT,DOGE/USDT

# ---- Signal rules -------------------------------------------
# Only act when the NET spread (after all costs) is at least this (%)
MIN_NET_SPREAD_PCT=0.3
# Size of each arbitrage trade, in USDT
TRADE_SIZE_USDT=100
# Extra safety margin for price moves while orders travel (%)
SLIPPAGE_BUFFER_PCT=0.05
# Subtract re-balancing withdrawal fees (coin A->B plus USDT B->A)
INCLUDE_WITHDRAWAL_FEE=true
# Trading volume between two re-balances; that cost is spread over it.
# Set equal to TRADE_SIZE_USDT for the most conservative estimate.
REBALANCE_BATCH_USDT=2000
# Ignore prices older than this (milliseconds)
MAX_QUOTE_AGE_MS=3000

# Taker fee per exchange as a fraction (0.001 = 0.1%). Set your real tier.
TAKER_FEES={"binance":0.001,"okx":0.001,"bybit":0.001,"kucoin":0.001}
# Withdrawal fee per coin, in coin units. Check each exchange's current fees.
WITHDRAWAL_FEES={"BTC":0.0002,"ETH":0.002,"SOL":0.01,"XRP":0.25,"DOGE":4,"USDT":1}

# ---- Execution ----------------------------------------------
# IOC limit price allowance past the quoted price (%), capped at half the edge
PRICE_TOLERANCE_PCT=0.2
# Wait this long before trading the same route again (seconds)
COOLDOWN_SECONDS=10
# Kill switch trips after this loss in one UTC day (USDT)
MAX_DAILY_LOSS_USDT=50

# ---- Paper trading ------------------------------------------
PAPER_QUOTE_BALANCE=10000       # simulated USDT on each exchange
PAPER_BASE_VALUE_USDT=5000      # simulated coin inventory per exchange, in USDT
PAPER_FAIL_RATE=0               # 0..1, randomly fail legs to test recovery

# ---- Network ------------------------------------------------
# Use official public-data hosts that work in more regions
# (data-stream.binance.vision, ws.okx.com:443). Keys are never sent to them.
USE_PUBLIC_DATA_ENDPOINTS=true

# ---- Dashboard / files --------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
DB_PATH=data/arbbot.sqlite3
LOG_FILE=logs/arbbot.log
LOG_LEVEL=INFO

# ---- API keys (live trading only) ---------------------------
# Create keys with TRADE permission only. NEVER enable withdrawals.
# Restrict each key to your IP address in the exchange settings.
BINANCE_API_KEY=
BINANCE_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSWORD=
BYBIT_API_KEY=
BYBIT_API_SECRET=
KUCOIN_API_KEY=
KUCOIN_API_SECRET=
KUCOIN_API_PASSWORD=
